{
    "name": "rimba/filament-authorization",
    "description": "Filament administration UI for RIMBA authorization using Laravel Permission Manager.",
    "keywords": ["laravel", "filament", "rimba", "authorization", "permission", "rbac", "abac", "roles"],
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "hosseinhezami/laravel-permission-manager": "^1.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Rimba\\\\FilamentAuthorization\\\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rimba\\\\FilamentAuthorization\\\\Tests\\\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rimba\\\\FilamentAuthorization\\\\RimbaFilamentAuthorizationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
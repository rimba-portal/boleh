{
    "name": "rimba/boleh",
    "description": "Filament authorization design studio for creation and assignment of permissions to filament resources.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BIT Ecosystem",
            "email": "bit.ecosystem@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "rimba/asas": "^1.3",
        "rimba/siapa": "^1.3",
        "rimba/sifat": "^1.3",
        "spatie/laravel-permission": "^7.3"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rimba\\Can\\CanServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
